# =============================================================================
# GillNet AI — Environment Configuration
# =============================================================================

# Backend REST API URL
# Leave empty on Vercel to use the built-in resilient client-side security engine,
# or set to your deployed Spring Boot backend URL (e.g., https://your-backend.onrender.com)
VITE_API_URL=

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# When set, "Continue with Google" opens the official Google Sign-In popup directly.
# Add your domain (e.g., https://your-app.vercel.app) to "Authorized JavaScript origins" in Google Console.
VITE_GOOGLE_CLIENT_ID=282362758732-lan9p372fivlpm14pd4qcaintcffgumn.apps.googleusercontent.com
